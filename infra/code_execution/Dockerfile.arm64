FROM public.ecr.aws/docker/library/python@sha256:9bb659dc6d5218917236f3711e866a5634bb4c2f208de9d4533aa4863f57c1d3

ARG PYARROW_VERSION=24.0.0
ARG FOUNDRY_LITE_RUNTIME_SOURCE_SHA=unknown

LABEL dev.foundry-lite.runtime-source-sha="${FOUNDRY_LITE_RUNTIME_SOURCE_SHA}" \
      org.opencontainers.image.revision="${FOUNDRY_LITE_RUNTIME_SOURCE_SHA}" \
      org.opencontainers.image.source="https://github.com/ludia8888/foundry-lite"

RUN python -m pip install --no-cache-dir "pyarrow==${PYARROW_VERSION}" \
    && groupadd --gid 65532 sandbox \
    && useradd --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin sandbox \
    && install -d -o 65532 -g 65532 -m 0555 /sandbox-output

COPY --chown=65532:65532 libs/foundry_lite/infrastructure/runners/python_transform_runner.py /opt/foundry-lite/runner/python_transform_runner.py
COPY --chown=65532:65532 libs/foundry_lite/infrastructure/runners/python_function_runner.py /opt/foundry-lite/runner/python_function_runner.py
COPY --chown=65532:65532 libs/foundry_lite/infrastructure/runners/python_function_osdk.py /opt/foundry-lite/runner/python_function_osdk.py
COPY --chown=65532:65532 libs/foundry_lite/transforms_sdk /opt/foundry-lite/foundry_lite/transforms_sdk

USER 65532:65532
WORKDIR /sandbox
