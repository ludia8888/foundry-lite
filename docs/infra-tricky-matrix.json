  "sourceOfTruthRules": {
    "metadata_db_committed_media_version_is_serving_truth": {
      "description": "Only a metadata DB COMMITTED media version is served; a stored blob alone is not truth.",
      "status": "enforced",
      "tests": [
        "test_staged_version_is_not_visible_until_commit",
        "test_resolve_hard_fails_when_committed_blob_is_missing",
        "test_resolve_hard_fails_when_committed_blob_is_corrupt"
      ]
    },
    "blob_existence_is_not_serving_truth": {
      "description": "A blob in object storage with no COMMITTED media version row is an invisible orphan, never served.",
      "status": "enforced",
      "tests": [
        "test_commit_failure_leaves_nothing_visible_and_leaves_orphan_evidence"
      ]
    },
    "media_reference_pins_immutable_version": {
      "description": "A MediaReference pins an immutable mediaItemVersionId, not a logical path; a head overwrite never changes what it resolves to.",
      "status": "enforced",
      "tests": [
        "test_reference_pins_immutable_version_after_same_path_overwrite"
      ]
    },
    "logical_path_head_is_not_historical_reference": {
      "description": "The logical-path head pointer is latest-lookup only; existing references keep resolving to their original bytes after overwrite.",
      "status": "enforced",
      "tests": [
        "test_reference_pins_immutable_version_after_same_path_overwrite",
        "test_concurrent_same_path_commits_keep_both_versions"
      ]
    },
    "derivatives_inherit_source_security": {
      "description": "Every derivative, content unit, embedding, and index entry carries a security envelope no weaker than its source.",
      "status": "enforced",
      "tests": [
        "test_process_commits_derivative_with_inherited_security_envelope"
      ]
    },
    "content_unit_artifact_is_truth_search_index_is_projection": {
      "description": "Committed content-unit artifacts are the truth; the content search index is a rebuildable projection.",
      "status": "enforced",
      "tests": [
        "test_content_index_rebuilds_from_committed_artifacts",
        "test_retrieval_drops_citation_hash_mismatch"
      ]
    },
    "content_search_pre_filters_by_classification_not_post_filter": {
      "description": "AIP P0a: content search compiles the caller's allowed-classification set into the query as a PRE-filter in both index adapters, so an over-classified unit never enters the kNN/ranking (closing the ranking/count side-channel) and never reaches an LLM; the authoritative DB re-read re-applies the same classification gate as defense-in-depth. None = full clearance, so empty-classification rows and uncleared callers are unchanged. Reuses the existing media-plane classification-access rule (allowed_classifications, mirroring MediaReferenceBindingService.resolve).",
      "status": "enforced",
      "tests": [
        "test_pre_filter_excludes_over_classified_unit_from_ranking",
        "test_search_pre_filters_over_classified_unit_end_to_end",
        "test_search_pre_filters_by_classification_term",
        "test_authoritative_re_read_drops_over_classified_leaked_by_stale_index"
      ]
    },
    "embedding_artifact_pins_model_version_and_chunk_spec": {
      "description": "An embedding artifact pins its embedding model version and chunk spec; index mismatch fails closed. L12a reuses this rule for object Vector properties: an object embedding pins its model version and a nearestNeighbors query in a different vector space fails closed.",
      "status": "enforced",
      "tests": [
        "test_embedding_artifact_pins_model_and_chunk_spec",
        "test_hybrid_search_fails_closed_on_model_version_mismatch",
        "test_object_embedding_pins_model_version_when_adapter_available",
        "test_nearest_neighbors_fails_closed_on_model_version_mismatch"
      ]
    },
    "workflow_status_does_not_replace_domain_commit": {
      "description": "A Temporal workflow status is not a media domain commit; the DB COMMITTED version remains the only success signal.",
      "status": "enforced",
      "tests": [
        "test_media_workflow_status_does_not_replace_domain_commit",
        "test_media_processing_workflow_runs_through_temporal_and_commits"
      ]
    },
    "access_pattern_cache_is_not_truth": {
      "description": "On-demand access-pattern derivatives (thumbnail/preview/waveform) are caches, never serving truth.",
      "status": "enforced",
      "tests": [
        "test_access_pattern_cache_hit_does_not_recompute",
        "test_access_pattern_cache_recomputes_on_stale_source",
        "test_reference_resolve_never_reads_access_cache"
      ]
    },
    "external_virtual_object_requires_version_or_mutable_marker": {
      "description": "A virtual external media item must record source version/etag or be marked mutable_external_reference; it must not silently read different bytes.",
      "status": "enforced",
      "tests": [
        "test_virtual_media_requires_version_or_mutable_marker",
        "test_virtual_etag_drift_fails_closed",
        "test_external_pinned_etag_resolves_against_live_object",
        "test_external_etag_drift_fails_closed_when_source_overwritten",
        "test_external_mutable_reference_surfaces_freshness_on_delete",
        "test_external_unversioned_register_is_rejected"
      ]
    },
    "retention_never_purges_reachable_or_legal_hold_version": {
      "description": "Retention purge never deletes a version still reachable by a MediaReference or under legal hold.",
      "status": "enforced",
      "tests": [
        "test_media_retention_skips_reachable_or_legal_hold",
        "test_retention_does_not_purge_before_grace_elapsed",
        "test_purge_audits_the_sweep"
      ]
    },
    "metadata_db_committed_version_is_serving_truth": {
      "description": "Only a metadata DB COMMITTED dataset version is served; storage objects alone are not truth.",
      "status": "enforced",
      "tests": [
        "test_s3_committed_manifest_missing_marks_storage_corruption",
        "test_iceberg_missing_table_on_read_marks_storage_corruption"
      ]
    },
    "object_storage_existence_is_not_serving_truth": {
      "description": "An object existing in S3/object storage with no COMMITTED DB row is never served; it is an orphan.",
      "status": "enforced",
      "tests": [
        "test_s3_commit_storage_success_db_failure_creates_orphan_cleanup_evidence"
      ]
    },
    "iceberg_snapshot_exists_but_db_committed_is_serving_truth": {
      "description": "An Iceberg snapshot with no COMMITTED DB row is an orphan; the DB version remains serving truth.",
      "status": "enforced",
      "tests": [
        "test_iceberg_snapshot_committed_db_failure_cleans_up_orphan_snapshot"
      ]
    },
    "search_index_is_projection_not_truth": {
      "description": "Search is a rebuildable projection; reads/actions refetch from the Object Store, never trust the index as truth.",
      "status": "enforced",
      "tests": [
        "test_masked_property_cannot_filter_sort_search",
        "test_static_object_set_rechecks_object_permission"
      ]
    },
    "runs_do_not_resolve_latest_during_execution": {
      "description": "A run pins input versions at planning; it must not silently re-resolve latest mid-execution.",
      "status": "enforced",
      "tests": ["test_transform_input_latest_is_pinned_to_version_id"]
    },
    "transform_input_version_is_pinned": {
      "description": "Transform input dataset versions are pinned by version_id for the whole run.",
      "status": "enforced",
      "tests": ["test_transform_input_latest_is_pinned_to_version_id"]
    },
    "materialized_output_not_truth_unless_pinned": {
      "description": "Downstream consumes the pinned materialized version_id, not implicit latest.",
      "status": "enforced",
      "tests": [
        "test_downstream_transform_consumes_materialized_version_id_not_latest"
      ]
    },
    "external_side_effects_commit_atomically_or_via_outbox": {
      "description": "Side effects (lineage/outbox) commit atomically with the domain transaction, not before it.",
      "status": "enforced",
      "tests": ["test_transform_output_and_lineage_commit_atomically"]
    },
    "external_timeout_is_outcome_unknown_not_failure": {
      "description": "A timeout from an external system means outcome_unknown, not a guaranteed failure.",
      "status": "enforced",
      "tests": [
        "test_action_external_timeout_is_outcome_unknown_not_failed",
        "test_external_writeback_adapter_contract_timeout_is_ambiguous_not_failure",
        "test_external_success_response_lost_becomes_outcome_unknown",
        "test_outcome_unknown_is_not_blindly_retried"
      ]
    },
    "external_failure_requires_compensation_not_silent_local_rollback": {
      "description": "External success + local failure requires a compensation path, not a silent local-only rollback.",
      "status": "enforced",
      "tests": [
        "test_action_external_success_local_failure_requires_real_compensation",
        "test_external_writeback_adapter_contract_remote_lookup_resolves_present_and_absent",
        "test_external_success_local_failure_requires_compensation",
        "test_compensation_is_idempotent",
        "test_reconciliation_resolves_remote_success"
      ]
    },
    "workflow_start_is_idempotent_by_idempotency_key": {
      "description": "A durable workflow start is idempotent by idempotency_key: re-start (or a concurrent start) attaches to the existing run and returns its outcome, never a duplicate run.",
      "status": "enforced",
      "tests": [
        "test_same_idempotency_key_returns_existing_run_without_duplicate",
        "test_concurrent_starts_on_one_key_produce_one_run"
      ]
    }
  }
