{
  "name": "foundry-lite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "ci:gate": "bash scripts/ci_gate.sh",
    "ci:gate:static": "bash scripts/ci_gate.sh static",
    "ci:gate:coverage": "bash scripts/ci_gate.sh coverage",
    "ci:gate:flaky": "bash scripts/ci_gate.sh flaky",
    "ci:gate:runtime": "bash scripts/ci_gate.sh runtime",
    "ci:gate:e2e": "bash scripts/ci_gate.sh e2e",
    "ci:gate:release": "bash scripts/ci_gate.sh release",
    "dev": "PYTHONPATH=.:libs:apps/api:apps/cli uv run python -m foundry_lite_api.main",
    "demo:supply-chain": "PYTHONPATH=.:libs:apps/cli:apps/api uv run python -m foundry_lite_cli.main demo run-supply-chain",
    "demo:supply-chain:fake-storage": "rm -rf .foundry-lite-fake-smoke && FOUNDRY_LITE_HOME=.foundry-lite-fake-smoke PYTHONPATH=.:libs:apps/cli:apps/api uv run python -m foundry_lite_cli.main --adapter-profile fake-storage demo run-supply-chain",
    "sdk:generate": "uv run python scripts/generate_sdk_ts.py",
    "diagnostics": "uv run python scripts/diagnostics/run_runtime_diagnostics.py",
    "diagnostics:trace": "uv run python scripts/diagnostics/run_runtime_diagnostics.py --console-traces",
    "worker:stream-archive": "PYTHONPATH=.:libs:apps/worker:apps/cli:apps/api uv run python -m foundry_lite_worker.stream_archive",
    "quality:complexity": "uv run radon cc libs apps scripts -s -a && uv run xenon --max-absolute B --max-modules B --max-average A libs apps scripts",
    "quality:architecture": "uv run python scripts/quality/check_dependency_graph.py && uv run tach check --dependencies",
    "quality:infra-boundaries": "uv run python scripts/quality/check_infra_import_boundary.py --max-application-imports 0 && uv run python scripts/quality/check_service_dependencies.py && uv run python scripts/quality/check_service_call_graph.py --max-depth 7 --max-fan-out 10",
    "quality:module-size": "uv run python scripts/quality/check_application_module_size.py --max-lines 500",
    "quality:function-length": "uv run python scripts/quality/check_function_length.py",
    "quality:boolean-naming": "uv run python scripts/quality/check_boolean_naming.py",
    "quality:dict-any-budget": "uv run python scripts/quality/check_dict_any_budget.py",
    "quality:any-boundary": "uv run python scripts/quality/check_application_any_budget.py",
    "quality:router-purity": "uv run python scripts/quality/check_router_layer_purity.py",
    "quality:query-side-effects": "uv run python scripts/quality/check_query_side_effects.py",
    "quality:repository-no-business": "uv run python scripts/quality/check_repository_no_business.py",
    "quality:tenant-write": "uv run python scripts/quality/check_tenant_write_guard.py",
    "quality:contract-tests": "uv run python scripts/quality/check_contract_test_per_port.py",
    "quality:strategy-spec-tests": "uv run python scripts/quality/check_strategy_specification_tests.py",
    "quality:integration-scenarios": "uv run python scripts/quality/check_integration_scenario_markers.py",
    "quality:testcontainers-preflight": "uv run python scripts/quality/check_testcontainers_preflight.py",
    "quality:kafka-live-broker": "uv run pytest tests/integration/test_kafka_live_broker_stream_archive.py -q",
    "quality:cdc-stream-archive": "uv run pytest tests/contracts/test_debezium_cdc_adapter_contract.py tests/integration/test_cdc_stream_archive.py -q",
    "quality:cdc-live-debezium": "uv run pytest tests/integration/test_debezium_live_cdc.py -q",
    "quality:cdc-object-indexing": "uv run pytest tests/unit/test_cdc_indexing.py tests/contracts/test_object_index_repository_contract.py tests/integration/test_cdc_object_indexing.py -q",
    "quality:shadow-reindex": "uv run pytest tests/contracts/test_object_index_repository_contract.py tests/contracts/test_object_read_repository_contract.py tests/contracts/test_object_set_repository_contract.py tests/integration/test_shadow_reindex.py -q",
    "quality:search-indexing": "uv run pytest tests/contracts/test_search_adapter_contract.py tests/integration/test_search_indexing.py -q",
    "quality:s3-storage": "uv run pytest tests/integration/test_s3_dataset_storage_adapter.py -q",
    "quality:iceberg": "uv run pytest tests/integration/test_iceberg_dataset_storage_adapter.py -q",
    "quality:spark": "uv run pytest tests/integration/test_spark_compute_adapter.py -q",
    "quality:temporal": "uv run pytest tests/integration/test_temporal_workflow_ratchet.py -q",
    "quality:elasticsearch": "uv run pytest tests/integration/test_elasticsearch_deployment_ratchet.py tests/integration/test_elasticsearch_live_cluster.py -q",
    "quality:infra-composition": "uv run pytest tests/integration/test_infra_composition_ratchet.py -q",
    "quality:regression-bugfix": "uv run python scripts/quality/check_regression_test_per_bugfix.py",
    "quality:pr-root-cause": "uv run python scripts/quality/check_pr_root_cause_section.py",
    "quality:doc-drift": "uv run python scripts/quality/check_doc_drift.py",
    "quality:checklist-evidence": "uv run python scripts/quality/check_checklist_evidence.py",
    "quality:infra-tricky-matrix": "uv run python scripts/quality/check_infra_tricky_matrix.py",
    "quality:proof-matrix": "uv run python scripts/quality/check_proof_matrix.py",
    "quality:source-of-truth": "uv run python scripts/quality/check_source_of_truth_contract.py",
    "quality:operator-evidence": "uv run python scripts/quality/check_operator_evidence_contract.py",
    "quality:runtime-root-cause": "uv run python scripts/quality/write_runtime_root_cause_summary.py",
    "quality:sdk-generated": "uv run python scripts/generate_sdk_ts.py --check",
    "quality:schema-revision": "uv run python scripts/quality/check_schema_revision_guard.py",
    "quality:audit-mutation": "uv run python scripts/quality/check_audit_on_mutation.py",
    "quality:transaction-outbox": "uv run python scripts/quality/check_transaction_outbox_pair.py",
    "quality:action-idempotency": "uv run python scripts/quality/check_idempotency_on_action.py",
    "quality:error-request-id": "uv run python scripts/quality/check_error_response_has_request_id.py",
    "quality:log-trace-keys": "uv run python scripts/quality/check_log_has_trace_keys.py",
    "quality:metrics-exposed": "uv run python scripts/quality/check_metrics_exposed.py",
    "quality:adapter-failure-taxonomy": "uv run python scripts/quality/check_adapter_failure_taxonomy.py",
    "quality:infra-ratchet": "uv run python scripts/quality/check_infra_ratchet.py",
    "quality:audit-runtime": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_audit_count_runtime.py",
    "quality:outbox-runtime": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_outbox_consistency.py",
    "quality:mvp-data-correctness": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_mvp_data_correctness.py",
    "quality:mvp-performance-smoke": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_mvp_performance_smoke.py",
    "quality:mvp-performance-release-100k": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_mvp_performance_smoke.py --profile release-100k --output artifacts/quality/mvp_performance_smoke_release_100k.json",
    "quality:mvp-performance-release-1m": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_mvp_performance_smoke.py --profile release-1m --output artifacts/quality/mvp_performance_smoke_release_1m.json",
    "quality:no-bypasses": "uv run python scripts/quality/check_no_test_bypasses.py",
    "quality:openlineage": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_openlineage_dynamic_lineage.py",
    "quality:trace-continuity": "PYTHONPATH=.:libs:apps/cli:apps/api:apps/worker uv run python scripts/quality/check_trace_continuity.py",
    "quality:adapter-error-trace": "uv run python scripts/quality/check_adapter_error_trace_keys.py",
    "quality:failed-mutation-state": "uv run python scripts/quality/check_failed_mutation_state_runtime.py",
    "quality:flaky-detector": "uv run python scripts/quality/check_flaky_detector.py",
    "quality:pragma-budget": "uv run python scripts/quality/check_pragma_no_cover_budget.py --baseline 0",
    "quality:private-tests": "uv run python scripts/quality/check_private_test_references.py --max-count 0",
    "quality:tier-coverage": "uv run python scripts/quality/check_tier_coverage_by_layer.py artifacts/coverage/coverage.json --threshold 95",
    "quality:ast-grep": "pnpm exec sg scan -c sgconfig.yml",
    "quality:static": "uv run ruff check . && uv run ruff format --check . && uv run mypy libs apps/api apps/cli apps/worker scripts && uv run pyright && pnpm quality:architecture && pnpm quality:infra-boundaries && uv run python scripts/quality/check_application_module_size.py --max-lines 500 && pnpm quality:function-length && pnpm quality:boolean-naming && pnpm quality:dict-any-budget && pnpm quality:any-boundary && pnpm quality:router-purity && pnpm quality:query-side-effects && pnpm quality:repository-no-business && pnpm quality:tenant-write && pnpm quality:contract-tests && pnpm quality:strategy-spec-tests && pnpm quality:integration-scenarios && pnpm quality:regression-bugfix && pnpm quality:pr-root-cause && pnpm quality:doc-drift && pnpm quality:checklist-evidence && pnpm quality:infra-tricky-matrix && pnpm quality:sdk-generated && pnpm quality:schema-revision && pnpm quality:audit-mutation && pnpm quality:transaction-outbox && pnpm quality:action-idempotency && pnpm quality:error-request-id && pnpm quality:log-trace-keys && pnpm quality:metrics-exposed && pnpm quality:adapter-failure-taxonomy && pnpm quality:infra-ratchet && uv run python scripts/quality/check_no_test_bypasses.py && uv run python scripts/quality/check_no_test_sleep.py && pnpm quality:pragma-budget && pnpm quality:private-tests && pnpm quality:ast-grep",
    "test": "PYTHONPATH=.:libs:apps/cli:apps/api uv run python -m pytest",
    "test:coverage": "PYTHONPATH=.:libs:apps/cli:apps/api uv run python -m pytest tests --cov=libs/foundry_lite --cov=apps/api --cov=apps/cli --cov=apps/worker --cov-branch --cov-fail-under=95",
    "test:e2e": "pnpm exec playwright test",
    "web:static": "uv run python -m http.server 4173 --directory apps/web",
    "lint": "PYTHONPATH=.:libs:apps/cli:apps/api uv run python -m compileall libs apps tests"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.43.0",
    "@playwright/test": "^1.53.0"
  }
}
